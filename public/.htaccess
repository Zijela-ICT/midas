<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve existing assets and files normally.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Send all application routes through the React entry point.
  RewriteRule ^ index.html [L]
</IfModule>
